# Все переменные читаются в config.py. Реальные ключи - только в .env (он в .gitignore).
# На платформе организаторов эти значения подставляются автоматически.

# OpenAI-совместимый API (на платформе - прокси организаторов; локально - своя замена)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash

# Отдельные ключи для эмбеддера и реранкера (если пусто - используется LLM_API_KEY)
EMBEDDER_API_KEY=
RERANKER_API_KEY=
EMB_MODEL=baai/bge-m3
# Реранкер: пусто = значение по умолчанию (как в примере организаторов); none = без реранкера (Ollama)
RERANKER_MODEL=

# Параметры поиска и генерации
TOP_K=8
RERANKER_TOP_N=5
TEMPERATURE=0.0
MAX_TOKENS=1024
MAX_WORKERS=4

# Где лежат questions.csv и knowledge-base.zip
DATA_DIR=data

# Таймауты: сколько ждать ответ модели (с) и сколько интерфейс ждёт ответ /ask (с).
# Для медленных локальных моделей на CPU увеличьте, например HTTP_TIMEOUT=300, ASK_TIMEOUT=360.
HTTP_TIMEOUT=90
ASK_TIMEOUT=180

# Веб-бэкенд
API_PORT=8000
